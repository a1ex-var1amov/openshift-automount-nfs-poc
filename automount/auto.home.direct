# Direct mount configuration for individual user directories
# This bypasses the indirect mount SELinux context issue

# Mount each user directory directly
usera -rw,vers=3,context=system_u:object_r:user_home_t:s0 172.30.240.59:/exports/home/usera
userb -rw,vers=3,context=system_u:object_r:user_home_t:s0 172.30.240.59:/exports/home/userb
userc -rw,vers=3,context=system_u:object_r:user_home_t:s0 172.30.240.59:/exports/home/userc
userd -rw,vers=3,context=system_u:object_r:user_home_t:s0 172.30.240.59:/exports/home/userd
usere -rw,vers=3,context=system_u:object_r:user_home_t:s0 172.30.240.59:/exports/home/usere
xyz   -rw,vers=3,context=system_u:object_r:user_home_t:s0 172.30.240.59:/exports/home/xyz
